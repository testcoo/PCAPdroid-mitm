<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页列表里的一行。

  两行文字的结构（标题 + 副标题），这是平台设置类界面的通行做法：
    · title     —— 这一项叫什么，如「工作目录」
    · summary   —— 它的当前值/说明，如「/storage/emulated/0/Download/MitmLauncher」
    summary 设了 textAppearanceSmall 让它比 title 小一号，视觉上从属。

  ★ 用 ?android:attr/selectableItemBackground 而不是自己画：
    这是**平台自带的点击反馈**（水波纹/高亮），跟随系统主题，
    比自己写 selector 更正确，也省一个 drawable 文件。

  ★ minHeight="?android:attr/listPreferredItemHeight" 是平台的列表项标准高度
    （通常 48dp），保证点击区域够大、符合系统的可点区域建议。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="?android:attr/listPreferredItemHeight"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/rowTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/rowSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="13sp" />

</LinearLayout>
