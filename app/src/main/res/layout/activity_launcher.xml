<?xml version="1.0" encoding="utf-8"?>
<!--
  MitmLauncher 主界面。

  设计约束（都很重要）：
    1. 工程**没有 androidx**，所以只能用平台控件（LinearLayout / TextView / Button /
       EditText / ScrollView），不能用 ConstraintLayout / AppCompat*。
    2. 左右留白给足（24dp）：手机上贴边看着很挤，且手指容易误触边缘。
    3. 日志区是「可选中复制 + 自动滚到底」，因此必须是
       ScrollView(带 id) > TextView(带 id)，不能直接把 TextView 当滚动容器
       —— TextView + ScrollingMovementMethod 无法用 fullScroll() 精确滚到底。
    4. 日志用 monospace：日志是等宽对齐的，等宽字体更易读。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- 标题：字号比正文大一档，并用粗体把它和控件区分开 -->
    <TextView
        android:id="@+id/argsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/args_label"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!--
      参数输入框：多行，但**限高**。

      ★ 为什么要限高：参数框是 wrap_content，参数里插了几个换行就会被撑得很高，
        把下面的日志区挤扁，且要滚动很久才能看到启动按钮 —— 一旦误粘一大段文本，
        整个界面都会变得难用。这里用 maxHeight 封顶，超出部分由 EditText 自己
        内部滚动（多行 EditText 自带上滚能力，不需要额外包 ScrollView）。

      ★ 没有"恢复默认"入口（用户明确不要）：改坏了就自己重新输入。
    -->
    <EditText
        android:id="@+id/argsBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top|start"
        android:hint="@string/args_hint"
        android:importantForAutofill="no"
        android:inputType="textNoSuggestions|textMultiLine"
        android:maxHeight="120dp"
        android:minHeight="48dp"
        android:scrollbars="vertical"
        android:textSize="14sp" />

    <Button
        android:id="@+id/toggleButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/btn_start" />

    <TextView
        android:id="@+id/statusView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="?android:attr/listDivider" />

    <!-- 日志头部：标题 + 清空按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/log_label"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- 复制：高频操作，紧跟在标题右侧 -->
        <Button
            android:id="@+id/copyLogButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/btn_copy_log" />

        <!-- 占位：把剩余空间全部吃掉，把「清空」推到屏幕另一端，
             与「复制」隔开，降低误点（清空是破坏性操作）。 -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/clearLogButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/btn_clear_log" />
    </LinearLayout>

    <!--
      日志区：ScrollView 提供滚动与「滚到底」能力，内层 TextView 负责显示。
      两者 id 都要有：ScrollView 给 fullScroll() / getChildAt() 用，
      TextView 给 setText() / getText() 用。

      ★ logView **不开** textIsSelectable：可选中会让 TextView 内部有一个 Editor
        管光标/选区，文本变化时它会请求「把光标滚进可视区」，导致翻看日志时界面
        自己跳走。复制改用标题栏的「复制」按钮（读 logView 的文本）。
    -->
    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="?android:attr/colorBackground"
        android:fadeScrollbars="false"
        android:scrollbarStyle="insideInset">

        <TextView
            android:id="@+id/logView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="10sp" />
    </ScrollView>

</LinearLayout>
