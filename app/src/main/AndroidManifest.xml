<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 前台服务：API 26+ 起必须显式声明 FOREGROUND_SERVICE + 具体类型；
         只写 _SPECIAL_USE 在部分 ROM/版本上会 startForeground 抛异常。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+ 前台服务通知要显示就必须有它，且要运行时申请；
         缺了的表现是「设置里通知是灰的、点不动」。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ★ CPU 唤醒锁：前台服务只保证「内存紧张时不杀你」，**不保证 CPU 不休眠**。
         息屏后内核会进入 suspend，Python 的 asyncio 事件循环随之停摆，
         外部发来的 TCP 握手就没人处理（表现：浏览器转圈直到超时）。
         拿 PARTIAL_WAKE_LOCK 才能让 CPU 在息屏时继续跑。
         ★ 只在代理真的跑起来之后才持有（见 LauncherService.acquireCpuLock），
           平时不持有，避免白白耗电。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ★ 「所有文件访问权」（Android 11+）。
         用途：让 mitmproxy（Python 侧）能用**普通文件路径**读写工作目录
               （/storage/emulated/0/Download/MitmLauncher）以及用户指定的任意路径，
               这样 `-s 脚本.py`、`-w 抓包.mitm` 都能直接生效。
         为什么不用 SAF（ACTION_OPEN_DOCUMENT_TREE）：SAF 给的是 content:// Uri，
              而 Python 要真实路径；上游为此做了两套，我们只需要一套。
         ⚠️ 这是 Google Play **政策受限**权限（仅限文件管理器/备份/杀毒等类别），
            上架会被拒；自己侧载安装完全不受影响。
         配套：Files.hasStorageAccess() 判断、Files.buildStorageAccessIntent() 引导用户开启。 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Android 10 及以下的传统存储权限（运行时申请）。
         声明时带 maxSdkVersion=29，避免在 Android 11+ 上多要一个无用的权限 ——
         那些版本上走的是 MANAGE_EXTERNAL_STORAGE。 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage" />

    <!-- PyApplication is equivalent to Python.start -->
    <application
        android:name="com.chaquo.python.android.PyApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        tools:targetApi="m">

        <!-- windowSoftInputMode：
               · adjustResize        键盘弹出时重排布局（日志区用 layout_weight，正是为此）
               · stateAlwaysHidden   窗口首次显示/获得焦点时不自动弹键盘
               只影响「窗口自己」弹键盘的时机，不影响用户主动点输入框时弹键盘。 -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 设置页。
             ★ android:parentActivityName 是 ActionBar 左上角返回箭头的前提：
               系统靠它知道"上一级"是谁，才画出箭头；点击返回箭头会以
               android.R.id.home 送到 onOptionsItemSelected（见 SettingsActivity）。
             ★ 同时声明 meta-data PARENT_ACTIVITY 是为了兼容 API 16 以下 —— 不过
               本工程 minSdk 24，其实用不到；但两个属性成对声明是惯例，成本为零。 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings"
            android:parentActivityName=".LauncherActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".LauncherActivity" />
        </activity>

        <!-- ★ android:process=":mitm"：mitmproxy 跑在独立子进程里。
             为什么必须拆（M2a 真机踩到的两个 P0 都源于同进程）：
               ① 同进程 ⇒ Python 工作线程一旦卡住（mitmproxy 启动失败时在 asyncio
                  拆 loop 阶段 await 会死锁），整个 App 的 UI 线程虽然还在跑，但
                  服务永久存活、端口永久被占，只能靠「强行停止应用」恢复。
               ② 拆出去之后，收尾兜底可以直接 Process.killProcess(myPid()) —— 在
                  :mitm 里自杀，内核回收该进程所有 fd（含监听 socket），主进程
                  （UI）完全不受影响，也不会弹「应用已停止」的崩溃框。
             代价：静态回调/静态变量跨不了进程，状态只能靠 status.txt（我们本来就
             用文件轮询，所以成本几乎为零）。
             注意 Chaquopy：<application android:name="PyApplication"> 保证每个进程
             各自初始化一次 Python，:mitm 里的 Python 环境是自动就绪的。 -->
        <service
            android:name=".LauncherService"
            android:exported="false"
            android:process=":mitm"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="run mitmproxy in the background"/>
        </service>
    </application>
</manifest>
